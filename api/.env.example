# --- New Supabase project (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- OpenAI ---
OPENAI_KEY=

# --- Dedicated read-only Postgres role (see db/schema.sql) ---
# postgresql://hive_readonly:<password>@<host>:5432/postgres
DB_READONLY_URL=

# --- Shared secret required as `Authorization: Bearer <API_KEY>` ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Comma-separated list of exact frontend origins allowed to call this API ---
ALLOWED_ORIGINS=http://localhost:3000

SEARCH_RATE_LIMIT=20/minute
