# --- New Supabase project (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Optional extraction model credential ---
# Normal /search does not use this. It is only read by the OpenAI-compatible
# extraction backend when WBM_LLM_BACKEND=openai or openai_compatible.
OPENAI_KEY=

# --- Dedicated read-only Postgres role (see db/schema.sql) ---
# postgresql://hive_readonly:<password>@<host>:5432/postgres
DB_READONLY_URL=

# --- Internal API: shared secret used only by web/'s server-side route ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# --- External API (/v1/search): comma-separated keys, one per agent/integration ---
# Generate each the same way. Revoke one agent by removing its key here,
# without touching INTERNAL_API_KEY or any other agent's key.
AGENT_API_KEYS=

# --- Comma-separated list of exact frontend origins allowed to call the internal API ---
ALLOWED_ORIGINS=http://localhost:3000

SEARCH_RATE_LIMIT=20/minute
AGENT_RATE_LIMIT=10/minute

# --- EXPERIMENTAL track (branch experimental/demo-day) -----------------------
EXPERIMENTAL_ENABLED=true
# hive_ingest role DSN (migration 005). Empty => ingestion returns 503.
DB_INGEST_URL=
# Valency Bond bearer token (app.valency.io -> Settings). Empty => PMC-only discovery.
VALENCY_API_TOKEN=
# Extraction model for live ingestion + paper QA.
WBM_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
WBM_MODEL=claude-opus-5

# --- experimental live ingestion / paper QA (model + full text) ---
CLAUDE_CLI=   # optional path to the claude executable when not on PATH
UNPAYWALL_EMAIL=   # a REAL contact email; Unpaywall is skipped without one
