# Base URL of the hive API backend (no trailing slash, no /search suffix)
API_BASE_URL=http://localhost:8000

# Calls the backend's *internal* endpoint. Must match INTERNAL_API_KEY in api/.env
# (not one of AGENT_API_KEYS - those are for external/agent callers only).
INTERNAL_API_KEY=

# Public browser auth configuration; never use a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
